# NovaTradeX — environment configuration (demo only)
# Copy to .env and fill in real values. Never commit real secrets.

# HTTP
PORT=3000
HOST=0.0.0.0

# SQLite location. Any writable path works; /data is the container volume mount.
# DATABASE_PATH=/data/novatradex.db
# DATA_DIR=/data

# Sessions
SESSION_TTL_HOURS=12

# Set to "false" to skip demo seeding (used by the automated tests).
DEMO_SEED=true

# Demo credentials for the seeded accounts (change for a real deployment).
DEMO_ADMIN_EMAIL=admin@novatradex.com
DEMO_ADMIN_PASSWORD=NovaOwner!2024
DEMO_CUSTOMER_EMAIL=demo@novatradex.com
DEMO_CUSTOMER_PASSWORD=DemoTrader!2024

# Token required by the one-time first-owner setup page (/admin/setup).
# The page is permanently locked after the first administrator exists.
OWNER_SETUP_TOKEN=change-me-before-deploying
